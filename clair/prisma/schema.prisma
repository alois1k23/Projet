generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Nul pour les comptes créés par lien e-mail, Google ou Apple.
  passwordHash String?
  name         String?
  /// Langue de l'interface et des explications : "fr" ou "de".
  locale       String     @default("fr")
  /// Adresse utilisée dans l'en-tête des lettres générées.
  addressLine  String?
  postalCode   String?
  city         String?
  plan         Plan       @default(FREE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  documents    Document[]
  tasks        Task[]
  letters      Letter[]
  oauthAccounts OAuthAccount[]
}

enum Plan {
  FREE
  PLUS
}

/// Le jeton de session n'est jamais stocké en clair : seul son hachage SHA-256 l'est.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Document {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  /// Type et taille de la première page (affichage) ; le détail est dans `files`.
  mimeType     String
  sizeBytes    Int
  source       DocumentSource @default(UPLOAD)
  status       DocumentStatus @default(PENDING)
  title        String
  sender       String?
  category     String?
  language     String?
  summary      String?
  /// Résultat complet de l'analyse (validé par le schéma Zod).
  analysis     Json?
  amount       Decimal?       @db.Decimal(12, 2)
  currency     String?
  dueDate      DateTime?      @db.Date
  confidence   Float?
  errorMessage String?
  analyzedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tasks        Task[]
  letters      Letter[]
  files        DocumentFile[]

  @@index([userId, createdAt])
}

/// Une page (photo) ou un PDF d'un courrier, chiffré dans le stockage.
model DocumentFile {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position   Int
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  @@unique([documentId, position])
}

enum DocumentSource {
  UPLOAD
  SAMPLE
}

enum DocumentStatus {
  PENDING
  ANALYZED
  NEEDS_REVIEW
  MANUAL
  FAILED
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  kind        TaskKind   @default(OTHER)
  dueDate     DateTime?  @db.Date
  amount      Decimal?   @db.Decimal(12, 2)
  status      TaskStatus @default(OPEN)
  remindedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status, dueDate])
}

enum TaskKind {
  PAY
  REPLY
  CANCEL
  CHECK
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
}

model Letter {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  templateId String
  language   String
  recipient  String
  subject    String
  body       String
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Jeton à usage unique envoyé par e-mail. Seul son hachage SHA-256 est stocké.
model AuthToken {
  id        String            @id
  email     String
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([email, purpose])
}

enum AuthTokenPurpose {
  LOGIN
  PASSWORD_RESET
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Personnes intéressées par une offre ou une langue à venir (site de présentation).
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  interest  String
  locale    String   @default("fr")
  createdAt DateTime @default(now())

  @@unique([email, interest])
}
