# Base de données PostgreSQL
DATABASE_URL="postgresql://clair:clair_dev@localhost:5432/clair_app"

# Clé de chiffrement des documents (32 octets en base64).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAIR_ENCRYPTION_KEY=""

# Dossier de stockage des fichiers chiffrés
CLAIR_STORAGE_DIR="./storage"

# Analyse IA des courriers. Sans clé, l'app fonctionne en saisie manuelle
# et propose des exemples clairement signalés.
ANTHROPIC_API_KEY=""
# Modèle utilisé pour l'analyse (par défaut : claude-opus-5-5)
CLAIR_AI_MODEL="claude-opus-5-5"
# "anthropic" (défaut si une clé existe) ou "mock" (tests automatisés uniquement)
CLAIR_AI_PROVIDER=""

# URL publique de l'application (liens dans les e-mails de rappel)
CLAIR_APP_URL="http://localhost:3000"

# Envoi d'e-mails (mot de passe oublié, lien de connexion, rappels).
# Exemple : smtps://utilisateur:motdepasse@mail.infomaniak.com:465
CLAIR_SMTP_URL=""
CLAIR_MAIL_FROM="Clair <bonjour@votre-domaine.ch>"
# "file" : écrit les e-mails dans storage/outbox.jsonl au lieu de les envoyer (activé par défaut hors production)
CLAIR_MAIL_TRANSPORT=""

# Connexion avec Google (console.cloud.google.com, identifiants OAuth « Application Web »)
# URI de redirection : <CLAIR_APP_URL>/api/auth/google/callback
CLAIR_GOOGLE_CLIENT_ID=""
CLAIR_GOOGLE_CLIENT_SECRET=""

# Connexion avec Apple (developer.apple.com, Services ID + clé « Sign in with Apple »)
# URI de retour : <CLAIR_APP_URL>/api/auth/apple/callback (HTTPS obligatoire)
CLAIR_APPLE_CLIENT_ID=""
CLAIR_APPLE_TEAM_ID=""
CLAIR_APPLE_KEY_ID=""
CLAIR_APPLE_PRIVATE_KEY=""

# Mode démo : bouton « Essayer la démo » (compte temporaire pré-rempli, effacé après 24 h).
# Sans ANTHROPIC_API_KEY, les analyses sont alors simulées et signalées comme telles.
CLAIR_DEMO=""
