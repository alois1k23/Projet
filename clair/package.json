{
  "name": "clair",
  "version": "0.1.0",
  "private": true,
  "description": "Clair — le copilote du courrier administratif suisse",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "reminders": "tsx --tsconfig tsconfig.json scripts/send-reminders.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "arctic": "^3.7.0",
    "lucide-react": "^1.56.0",
    "next": "15.5.27",
    "nodemailer": "^10.1.0",
    "pdf-lib": "1.17.1",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.27",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
